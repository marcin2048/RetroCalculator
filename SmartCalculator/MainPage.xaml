<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RetroCalculator.MainPage"
             BackgroundColor="#080808"
             Title="Kalkulator">
    <ContentPage.Resources>
        <Style x:Key="CalculatorButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#242424" />
            <Setter Property="TextColor" Value="#F4F4F4" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource CalculatorButton}">
            <Setter Property="BackgroundColor" Value="#9A6500" />
            <Setter Property="TextColor" Value="#FFF5C2" />
        </Style>
        <Style x:Key="MemoryButton" TargetType="Button" BasedOn="{StaticResource CalculatorButton}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BackgroundColor" Value="#383838" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="12" RowSpacing="8" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" BackgroundColor="#D6B900" Stroke="#806F00" StrokeThickness="2" Padding="12,6">
            <Grid>
                <Label x:Name="DisplayLabel"
                       Text="0"
                       TextColor="#171500"
                       FontSize="42"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center"
                       LineBreakMode="NoWrap"
                       HeightRequest="72"
                       SemanticProperties.Description="Wynik kalkulatora" />

                <Label x:Name="MemoryIndicator"
                       Text="M"
                       TextColor="#171500"
                       FontSize="18"
                       FontAttributes="Bold"
                       IsVisible="False"
                       HorizontalOptions="Start"
                       VerticalOptions="Start" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
            <Button Grid.Column="0" Text="MC" Style="{StaticResource MemoryButton}" Clicked="OnButtonClicked" />
            <Button Grid.Column="1" Text="MR" Style="{StaticResource MemoryButton}" Clicked="OnButtonClicked" />
            <Button Grid.Column="2" Text="M−" Style="{StaticResource MemoryButton}" Clicked="OnButtonClicked" />
            <Button Grid.Column="3" Text="M+" Style="{StaticResource MemoryButton}" Clicked="OnButtonClicked" />
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*" RowSpacing="4" ColumnSpacing="4">
            <Button Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="0" Grid.Column="1" Text="±" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="0" Grid.Column="2" Text="%" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="0" Grid.Column="3" Text="÷" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />

            <Button Grid.Row="1" Grid.Column="0" Text="7" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="1" Grid.Column="1" Text="8" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="1" Grid.Column="2" Text="9" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="1" Grid.Column="3" Text="×" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />

            <Button Grid.Row="2" Grid.Column="0" Text="4" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="2" Grid.Column="1" Text="5" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="2" Grid.Column="2" Text="6" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="2" Grid.Column="3" Text="−" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />

            <Button Grid.Row="3" Grid.Column="0" Text="1" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="3" Grid.Column="1" Text="2" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="3" Grid.Column="2" Text="3" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="3" Grid.Column="3" Text="+" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />

            <Button Grid.Row="4" Grid.Column="0" Text="0" Grid.ColumnSpan="2" Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="4" Grid.Column="2" Text="," Style="{StaticResource CalculatorButton}" Clicked="OnButtonClicked" />
            <Button Grid.Row="4" Grid.Column="3" Text="=" Style="{StaticResource OperatorButton}" Clicked="OnButtonClicked" />
        </Grid>
    </Grid>
</ContentPage>

